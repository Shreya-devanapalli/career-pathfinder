# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_pathfinder

# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=my-super-secret-key-12345678910

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]